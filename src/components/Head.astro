---
import Default from '@astrojs/starlight/components/Head.astro';
---
<Default {...Astro.props}><slot /></Default>

<style>
  #sl-sidebar-toggle {
    position: fixed;
    top: 50vh;
    transform: translateY(-50%);
    z-index: 9999;
    width: 18px;
    height: 44px;
    background: var(--sl-color-bg-sidebar, #f6f6f6);
    border: 1px solid var(--sl-color-hairline-light, #e0e0e0);
    border-left: none;
    border-radius: 0 6px 6px 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: var(--sl-color-text-accent, #444);
    padding: 0;
    line-height: 1;
    transition: background 0.15s;
    /* JS가 위치 잡을 때까지 숨김 */
    display: none;
  }

  #sl-sidebar-toggle.ready {
    display: flex;
  }

  #sl-sidebar-toggle:hover {
    background: var(--sl-color-bg-inline-code, #eee);
  }

  /* 사이드바 숨김 상태 */
  body.sl-sidebar-hidden nav.sidebar {
    display: none !important;
  }

  body.sl-sidebar-hidden .page {
    --sl-sidebar-width: 0px !important;
  }

  /* 모바일에서는 버튼 숨김 */
  @media (max-width: 72rem) {
    #sl-sidebar-toggle {
      display: none !important;
    }
  }
</style>

<script>
  function initSidebarToggle() {
    // 기존 버튼 제거
    const existing = document.getElementById('sl-sidebar-toggle');
    if (existing) existing.remove();

    // 사이드바 없는 페이지(홈 등)는 무시
    const sidebar = document.querySelector('nav.sidebar');
    if (!sidebar) return;

    // 데스크탑 크기에서만 버튼 생성
    if (window.innerWidth <= 1152) return;

    const btn = document.createElement('button');
    btn.id = 'sl-sidebar-toggle';
    btn.setAttribute('aria-label', '사이드바 토글');
    document.body.appendChild(btn);

    function updatePosition() {
      if (document.body.classList.contains('sl-sidebar-hidden')) {
        btn.style.left = '0px';
      } else {
        const rect = sidebar.getBoundingClientRect();
        btn.style.left = rect.right + 'px';
      }
    }

    function applyState(hidden: boolean) {
      document.body.classList.toggle('sl-sidebar-hidden', hidden);
      btn.textContent = hidden ? '▶' : '◀';
      updatePosition();
    }

    btn.addEventListener('click', () => {
      const hidden = !document.body.classList.contains('sl-sidebar-hidden');
      applyState(hidden);
      localStorage.setItem('sl-sidebar-hidden', hidden ? '1' : '0');
    });

    // 저장된 상태 복원
    applyState(localStorage.getItem('sl-sidebar-hidden') === '1');

    // 위치 확정 후 버튼 표시
    requestAnimationFrame(() => {
      updatePosition();
      btn.classList.add('ready');
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth <= 1152) {
        btn.style.display = 'none';
      } else {
        btn.style.display = '';
        updatePosition();
      }
    });
  }

  initSidebarToggle();
  document.addEventListener('astro:page-load', initSidebarToggle);
</script>
