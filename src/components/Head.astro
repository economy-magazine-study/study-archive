---
import Default from '@astrojs/starlight/components/Head.astro';
---
<Default {...Astro.props}><slot /></Default>

<style>
  #sl-sidebar-toggle {
    position: fixed;
    top: 50%;
    left: var(--sl-sidebar-width, 16rem);
    transform: translateY(-50%);
    z-index: 999;
    width: 18px;
    height: 44px;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-left: none;
    border-radius: 0 6px 6px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: var(--sl-color-text-accent);
    transition: left 0.25s ease;
    padding: 0;
    line-height: 1;
  }

  #sl-sidebar-toggle:hover {
    background: var(--sl-color-bg-inline-code);
  }

  body.sl-sidebar-hidden #starlight__sidebar {
    display: none !important;
  }

  body.sl-sidebar-hidden .page {
    --sl-sidebar-width: 0rem !important;
  }

  body.sl-sidebar-hidden #sl-sidebar-toggle {
    left: 0;
    border-left: 1px solid var(--sl-color-hairline-light);
    border-radius: 0 6px 6px 0;
  }

  @media (max-width: 72rem) {
    #sl-sidebar-toggle {
      display: none;
    }
  }
</style>

<script>
  function initSidebarToggle() {
    const btn = document.createElement('button');
    btn.id = 'sl-sidebar-toggle';
    btn.setAttribute('aria-label', '사이드바 열기/닫기');
    btn.innerHTML = '◀';
    document.body.appendChild(btn);

    function applyState(hidden: boolean) {
      if (hidden) {
        document.body.classList.add('sl-sidebar-hidden');
        btn.innerHTML = '▶';
        btn.title = '사이드바 열기';
      } else {
        document.body.classList.remove('sl-sidebar-hidden');
        btn.innerHTML = '◀';
        btn.title = '사이드바 닫기';
      }
    }

    // 저장된 상태 복원
    const saved = localStorage.getItem('sl-sidebar-hidden');
    if (saved === '1') applyState(true);

    btn.addEventListener('click', () => {
      const hidden = !document.body.classList.contains('sl-sidebar-hidden');
      applyState(hidden);
      localStorage.setItem('sl-sidebar-hidden', hidden ? '1' : '0');
    });
  }

  // 페이지 로드 시 실행
  initSidebarToggle();

  // View Transitions 지원 (Astro)
  document.addEventListener('astro:page-load', initSidebarToggle);
</script>
