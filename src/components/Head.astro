---
import Default from '@astrojs/starlight/components/Head.astro';
---
<Default {...Astro.props}><slot /></Default>

<style>
  #sl-sidebar-toggle {
    position: fixed;
    top: 50vh;
    transform: translateY(-50%);
    z-index: 9999;
    width: 18px;
    height: 44px;
    background: var(--sl-color-bg-nav, #f6f6f6);
    border: 1px solid var(--sl-color-hairline-light, #e0e0e0);
    border-left: none;
    border-radius: 0 6px 6px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: var(--sl-color-text-accent, #444);
    padding: 0;
    line-height: 1;
    transition: background 0.15s;
  }

  #sl-sidebar-toggle:hover {
    background: var(--sl-color-bg-inline-code, #eee);
  }

  body.sl-sidebar-hidden #starlight__sidebar {
    display: none !important;
  }

  body.sl-sidebar-hidden .page {
    --sl-sidebar-width: 0px !important;
  }

  body.sl-sidebar-hidden #sl-sidebar-toggle {
    left: 0px !important;
    border-left: 1px solid var(--sl-color-hairline-light, #e0e0e0);
    border-radius: 0 6px 6px 0;
  }

  @media (max-width: 72rem) {
    #sl-sidebar-toggle {
      display: none !important;
    }
  }
</style>

<script>
  function initSidebarToggle() {
    const existing = document.getElementById('sl-sidebar-toggle');
    if (existing) existing.remove();

    const sidebar = document.getElementById('starlight__sidebar');
    if (!sidebar) return;

    const btn = document.createElement('button');
    btn.id = 'sl-sidebar-toggle';
    btn.setAttribute('aria-label', '사이드바 토글');
    document.body.appendChild(btn);

    function updateBtnPosition() {
      if (document.body.classList.contains('sl-sidebar-hidden')) {
        btn.style.left = '0px';
      } else {
        const rect = sidebar.getBoundingClientRect();
        btn.style.left = rect.right + 'px';
      }
    }

    function applyState(hidden: boolean) {
      document.body.classList.toggle('sl-sidebar-hidden', hidden);
      btn.textContent = hidden ? '▶' : '◀';
      updateBtnPosition();
    }

    btn.addEventListener('click', () => {
      const hidden = !document.body.classList.contains('sl-sidebar-hidden');
      applyState(hidden);
      localStorage.setItem('sl-sidebar-hidden', hidden ? '1' : '0');
    });

    // 저장된 상태 복원
    const saved = localStorage.getItem('sl-sidebar-hidden') === '1';
    applyState(saved);

    // 리사이즈 시 위치 재계산
    window.addEventListener('resize', updateBtnPosition);
  }

  initSidebarToggle();
  document.addEventListener('astro:page-load', initSidebarToggle);
</script>
