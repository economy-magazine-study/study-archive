---
type Props = {
  title: string;
  description?: string;
  active?: 'entities' | 'graph' | 'overview';
};

const { title, description = '경제잡지 스터디 아카이브 탐색 도구입니다.', active = 'overview' } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/u, '/');
const navItems = [
  { key: 'overview', label: '개요', href: `${base}archive/` },
  { key: 'entities', label: '색인', href: `${base}archive/entities/` },
  { key: 'graph', label: '관계도', href: `${base}archive/graph/` },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | 경제잡지 스터디 아카이브</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={base}>경제잡지 스터디 아카이브</a>
      <nav class="nav" aria-label="아카이브 탐색">
        {navItems.map((item) => <a class:list={['nav-link', { active: active === item.key }]} href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main class="shell">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --archive-bg: #f7f8f5;
    --archive-surface: #ffffff;
    --archive-text: #20242a;
    --archive-muted: #667085;
    --archive-line: #d8ddd5;
    --archive-strong: #204b45;
    --archive-accent: #b3482d;
    --archive-accent-soft: #f8e8df;
    --archive-blue: #2b5c86;
    --archive-green: #3f6f5c;
    --archive-radius: 8px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--archive-bg);
    color: var(--archive-text);
  }

  a {
    color: inherit;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
    padding: 0 32px;
    border-bottom: 1px solid var(--archive-line);
    background: rgba(247, 248, 245, 0.94);
    backdrop-filter: blur(10px);
  }

  .brand {
    font-weight: 750;
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 6px;
  }

  .nav-link {
    min-width: 64px;
    padding: 9px 12px;
    border: 1px solid transparent;
    border-radius: var(--archive-radius);
    color: var(--archive-muted);
    text-align: center;
    text-decoration: none;
  }

  .nav-link.active,
  .nav-link:hover {
    border-color: var(--archive-line);
    background: var(--archive-surface);
    color: var(--archive-text);
  }

  .shell {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 36px 0 56px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--archive-accent);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--archive-line);
  }

  .page-title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.06;
  }

  .page-copy {
    max-width: 760px;
    margin: 12px 0 0;
    color: var(--archive-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .metric-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .metric {
    min-width: 112px;
    padding: 10px 12px;
    border: 1px solid var(--archive-line);
    border-radius: var(--archive-radius);
    background: var(--archive-surface);
  }

  .metric strong {
    display: block;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .metric span {
    color: var(--archive-muted);
    font-size: 0.78rem;
  }

  .section-title {
    margin: 34px 0 14px;
    font-size: 1.25rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin: 18px 0 22px;
  }

  .input,
  .select {
    min-height: 40px;
    border: 1px solid var(--archive-line);
    border-radius: var(--archive-radius);
    background: var(--archive-surface);
    color: var(--archive-text);
    font: inherit;
  }

  .input {
    min-width: min(360px, 100%);
    padding: 0 12px;
  }

  .select {
    padding: 0 10px;
  }

  .button-link,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--archive-line);
    border-radius: var(--archive-radius);
    background: var(--archive-surface);
    color: var(--archive-text);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .button-link.primary,
  .button.primary {
    border-color: var(--archive-strong);
    background: var(--archive-strong);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .card {
    border: 1px solid var(--archive-line);
    border-radius: var(--archive-radius);
    background: var(--archive-surface);
  }

  .card-pad {
    padding: 16px;
  }

  .muted {
    color: var(--archive-muted);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 8px;
    border: 1px solid var(--archive-line);
    border-radius: 999px;
    background: #fff;
    color: var(--archive-muted);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .doc-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doc-item {
    display: grid;
    gap: 6px;
    padding: 14px;
    border: 1px solid var(--archive-line);
    border-radius: var(--archive-radius);
    background: var(--archive-surface);
  }

  .doc-item a {
    font-weight: 730;
    text-decoration: none;
  }

  .doc-meta {
    color: var(--archive-muted);
    font-size: 0.84rem;
  }

  @media (max-width: 720px) {
    .topbar {
      position: static;
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      padding: 14px 20px;
    }

    .nav {
      width: 100%;
    }

    .nav-link {
      flex: 1;
    }

    .shell {
      width: min(100% - 28px, 1180px);
      padding-top: 24px;
    }

    .page-header {
      grid-template-columns: 1fr;
    }
  }
</style>
