---
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import { buildGraphPayload, getArchiveIndex, withBase } from '../../../lib/archive-index';

const index = await getArchiveIndex();
const payload = buildGraphPayload(index);
const graphDataHref = withBase('archive/graph.json');
const relationCount = payload.docs.reduce((sum, doc) => sum + doc.facets.length, 0);
const maxFacetCount = Math.max(...payload.facets.map((facet) => facet.count), 1);
const defaultTypes = new Set(payload.facetTypes.map((type) => type.type));
---

<ArchiveLayout
  title="관계도"
  description="문서와 프론트매터 항목의 동시 등장 관계를 탐색하는 정적 그래프입니다."
  active="graph"
>
  <header class="page-header">
    <div>
      <p class="eyebrow">relationship map</p>
      <h1 class="page-title">관계도</h1>
      <p class="page-copy">
        각 문서는 작은 점, 엔티티와 주제는 큰 점으로 배치했습니다. 유형은 기본적으로 모두 켜두고, 너무 넓은
        축만 기본값에서 줄여 실질적인 연결을 더 잘 보이게 했습니다.
      </p>
    </div>
    <div class="metric-strip">
      <div class="metric"><strong>{payload.docs.length}</strong><span>문서</span></div>
      <div class="metric"><strong>{payload.facets.length}</strong><span>항목</span></div>
      <div class="metric"><strong>{relationCount}</strong><span>연결</span></div>
    </div>
  </header>

  <section class="graph-controls" aria-label="관계도 필터">
    <input id="graphSearch" class="input" type="search" placeholder="항목, 문서, 발표자 검색" autocomplete="off" />
    <label class="range-control">
      <span>최소 문서 수</span>
      <input id="minCount" type="range" min="1" max={Math.min(maxFacetCount, 12)} value="2" />
      <output id="minCountValue">2</output>
    </label>
    <label class="toggle-control">
      <input id="hideBroad" type="checkbox" checked />
      <span>넓은 축 숨김</span>
    </label>
    <div class="zoom-controls" aria-label="확대 축소">
      <button id="zoomOut" class="icon-button" type="button" aria-label="축소">-</button>
      <label class="range-control zoom-range">
        <span>확대</span>
        <input id="zoomLevel" type="range" min="0.6" max="2.4" step="0.1" value="1" />
        <output id="zoomValue">100%</output>
      </label>
      <button id="zoomIn" class="icon-button" type="button" aria-label="확대">+</button>
      <button id="resetView" class="button compact-action" type="button">보기 초기화</button>
    </div>
    <button id="resetGraph" class="button" type="button">초기화</button>
  </section>

  <section class="type-controls" aria-label="관계도 유형 선택">
    <div class="type-actions">
      <button id="selectAllTypes" class="button compact-action" type="button">전체 선택</button>
      <button id="clearTypes" class="button compact-action" type="button">전체 해제</button>
    </div>
    {
      payload.facetTypes.map((type) => (
        <label class="toggle-control compact">
          <input type="checkbox" data-graph-type={type.type} checked={defaultTypes.has(type.type)} />
          <span>{type.label}</span>
        </label>
      ))
    }
  </section>

  <section class="graph-workspace" id="graphRoot" data-src={graphDataHref}>
    <div class="graph-main">
      <div class="graph-status" id="graphStatus">관계도를 준비하고 있습니다.</div>
      <svg id="graphCanvas" class="graph-canvas" role="img" aria-label="문서와 메타데이터 항목의 관계도"></svg>
    </div>
    <aside class="graph-info" id="graphInfo" aria-live="polite">
      <strong>선택 없음</strong>
      <p>점을 선택하면 연결된 문서나 항목 정보를 볼 수 있습니다.</p>
    </aside>
  </section>
</ArchiveLayout>

<script>
  const root = document.getElementById('graphRoot');
  const svg = document.getElementById('graphCanvas');
  const info = document.getElementById('graphInfo');
  const status = document.getElementById('graphStatus');
  const search = document.getElementById('graphSearch');
  const minCount = document.getElementById('minCount');
  const minCountValue = document.getElementById('minCountValue');
  const hideBroad = document.getElementById('hideBroad');
  const reset = document.getElementById('resetGraph');
  const zoomOut = document.getElementById('zoomOut');
  const zoomIn = document.getElementById('zoomIn');
  const zoomLevel = document.getElementById('zoomLevel');
  const zoomValue = document.getElementById('zoomValue');
  const resetView = document.getElementById('resetView');
  const selectAllTypes = document.getElementById('selectAllTypes');
  const clearTypes = document.getElementById('clearTypes');
  const typeInputs = Array.from(document.querySelectorAll('[data-graph-type]'));
  const typeColors = {
    countries: '#7a8290',
    regions: '#2f7d72',
    organizations: '#2b5c86',
    companies: '#b3482d',
    people: '#4f7a3d',
    indicators: '#a46717',
    topics: '#66518f',
    tags: '#68727f',
    keywords: '#8a5d3c',
  };

  const normalize = (value) => value.normalize('NFKC').toLocaleLowerCase('ko-KR').trim();
  const lookupKey = (facet) => `${facet.type}:${facet.id}`;
  const nodeId = (prefix, id) => `${prefix}:${id}`;
  let graphData;
  let selectedNodeId = '';
  let viewportLayer;
  let activeLabelLayer;
  let activeLabelNode;
  let graphElements = { nodes: [], links: [], labels: [] };
  let graphSize = { width: 0, height: 0 };
  const viewport = { scale: 1, x: 0, y: 0 };
  const panStart = { active: false, pointerId: 0, clientX: 0, clientY: 0, x: 0, y: 0 };

  fetch(root.dataset.src)
    .then((response) => response.json())
    .then((data) => {
      graphData = data;
      renderGraph();
    })
    .catch(() => {
      status.textContent = '관계도 데이터를 불러오지 못했습니다.';
    });

  for (const control of [search, minCount, hideBroad]) {
    control.addEventListener('input', renderGraph);
    control.addEventListener('change', renderGraph);
  }
  for (const input of typeInputs) input.addEventListener('change', renderGraph);
  selectAllTypes.addEventListener('click', () => {
    for (const input of typeInputs) input.checked = true;
    renderGraph();
  });
  clearTypes.addEventListener('click', () => {
    for (const input of typeInputs) input.checked = false;
    selectedNodeId = '';
    renderGraph();
  });
  zoomLevel.addEventListener('input', () => setZoom(Number(zoomLevel.value)));
  zoomOut.addEventListener('click', () => setZoom(viewport.scale - 0.2));
  zoomIn.addEventListener('click', () => setZoom(viewport.scale + 0.2));
  resetView.addEventListener('click', resetViewport);
  svg.addEventListener(
    'wheel',
    (event) => {
      event.preventDefault();
      setZoom(viewport.scale + (event.deltaY > 0 ? -0.1 : 0.1));
    },
    { passive: false },
  );
  svg.addEventListener('pointerdown', (event) => {
    if (event.target.closest?.('.graph-node')) return;
    panStart.active = true;
    panStart.pointerId = event.pointerId;
    panStart.clientX = event.clientX;
    panStart.clientY = event.clientY;
    panStart.x = viewport.x;
    panStart.y = viewport.y;
    svg.setPointerCapture(event.pointerId);
    svg.classList.add('panning');
  });
  svg.addEventListener('pointermove', (event) => {
    if (!panStart.active || panStart.pointerId !== event.pointerId) return;
    viewport.x = panStart.x + event.clientX - panStart.clientX;
    viewport.y = panStart.y + event.clientY - panStart.clientY;
    applyViewport();
  });
  svg.addEventListener('pointerup', endPan);
  svg.addEventListener('pointercancel', endPan);
  reset.addEventListener('click', () => {
    search.value = '';
    minCount.value = '2';
    hideBroad.checked = true;
    for (const input of typeInputs) input.checked = true;
    selectedNodeId = '';
    resetViewport();
    renderGraph();
  });
  window.addEventListener('resize', () => {
    if (graphData) renderGraph();
  });

  function currentTypeSet() {
    return new Set(typeInputs.filter((input) => input.checked).map((input) => input.dataset.graphType));
  }

  function buildVisibleModel() {
    const query = normalize(search.value);
    const selectedTypes = currentTypeSet();
    const min = Number(minCount.value);
    const docsById = new Map(graphData.docs.map((doc) => [doc.id, doc]));

    let facets = graphData.facets.filter((facet) => {
      if (!selectedTypes.has(facet.type)) return false;
      if (facet.count < min) return false;
      if (hideBroad.checked && facet.broad) return false;
      if (!query) return true;
      const facetMatches = normalize(`${facet.name} ${facet.label}`).includes(query);
      const docMatches = facet.docIds.some((docId) => {
        const doc = docsById.get(docId);
        return doc && normalize(`${doc.title} ${doc.author} ${doc.weekLabel}`).includes(query);
      });
      return facetMatches || docMatches;
    });

    facets.sort((a, b) => b.count * b.weight - a.count * a.weight || b.count - a.count || a.name.localeCompare(b.name, 'ko'));
    facets = facets.slice(0, 100);

    const facetKeys = new Set(facets.map(lookupKey));
    let docs = graphData.docs.filter((doc) => doc.facets.some((facet) => facetKeys.has(lookupKey(facet))));
    if (query) {
      docs = docs.filter((doc) => {
        const docMatches = normalize(`${doc.title} ${doc.author} ${doc.weekLabel}`).includes(query);
        const linkedMatch = doc.facets.some((facet) => facetKeys.has(lookupKey(facet)));
        return docMatches || linkedMatch;
      });
    }
    docs = docs.slice(0, 160);

    const docIds = new Set(docs.map((doc) => doc.id));
    const links = [];
    const connectedFacetKeys = new Set();
    for (const doc of docs) {
      for (const facetRef of doc.facets) {
        const key = lookupKey(facetRef);
        if (!facetKeys.has(key)) continue;
        links.push({ source: nodeId('doc', doc.id), target: nodeId('facet', key), type: facetRef.type });
        connectedFacetKeys.add(key);
      }
    }
    facets = facets.filter((facet) => connectedFacetKeys.has(lookupKey(facet)));

    return {
      facets,
      docs: docs.filter((doc) => docIds.has(doc.id)),
      links,
      nodes: [
        ...facets.map((facet) => ({ ...facet, nodeType: 'facet', nodeId: nodeId('facet', lookupKey(facet)) })),
        ...docs.map((doc) => ({ ...doc, nodeType: 'doc', nodeId: nodeId('doc', doc.id) })),
      ],
    };
  }

  function renderGraph() {
    if (!graphData) return;
    minCountValue.textContent = minCount.value;
    const model = buildVisibleModel();
    svg.replaceChildren();
    viewportLayer = undefined;
    activeLabelLayer = undefined;
    activeLabelNode = undefined;
    graphElements = { nodes: [], links: [], labels: [] };

    if (model.nodes.length === 0) {
      status.textContent = '조건에 맞는 연결이 없습니다.';
      info.innerHTML = '<strong>선택 없음</strong><p>필터를 낮추거나 유형을 더 켜보세요.</p>';
      return;
    }

    status.textContent = `${model.docs.length}개 문서 · ${model.facets.length}개 항목 · ${model.links.length}개 연결`;
    const box = svg.getBoundingClientRect();
    const width = Math.max(320, Math.round(box.width || 900));
    const height = Math.max(420, Math.round(box.height || 620));
    graphSize = { width, height };
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

    const nodes = layoutNodes(model.nodes, model.links, width, height);
    const nodesById = new Map(nodes.map((node) => [node.nodeId, node]));
    const fragment = document.createDocumentFragment();
    const linkLayer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    const nodeLayer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    const labelLayer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    activeLabelLayer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    activeLabelLayer.setAttribute('id', 'graphActiveLabel');
    viewportLayer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    viewportLayer.setAttribute('id', 'graphViewport');

    for (const link of model.links) {
      const source = nodesById.get(link.source);
      const target = nodesById.get(link.target);
      if (!source || !target) continue;
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', source.x);
      line.setAttribute('y1', source.y);
      line.setAttribute('x2', target.x);
      line.setAttribute('y2', target.y);
      line.setAttribute('stroke', typeColors[link.type] ?? '#9aa3af');
      line.setAttribute('stroke-width', '0.8');
      line.setAttribute('stroke-opacity', '0.22');
      linkLayer.append(line);
      graphElements.links.push({ element: line, source, target });
    }

    for (const node of nodes) {
      const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      group.setAttribute('class', `graph-node ${node.nodeType}`);
      group.setAttribute('transform', `translate(${node.x}, ${node.y})`);
      group.setAttribute('tabindex', '0');
      group.setAttribute('role', 'link');
      group.setAttribute('aria-label', node.nodeType === 'facet' ? `${node.name}, ${node.label}` : node.title);

      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      const radius = node.nodeType === 'facet' ? Math.min(20, 6 + Math.sqrt(node.count) * 2.2) : 4.2;
      node.radius = radius;
      circle.setAttribute('r', radius);
      circle.setAttribute('fill', node.nodeType === 'facet' ? typeColors[node.type] ?? '#204b45' : '#f9fafb');
      circle.setAttribute('stroke', node.nodeType === 'facet' ? '#ffffff' : '#204b45');
      circle.setAttribute('stroke-width', node.nodeType === 'facet' ? '1.8' : '1.2');
      group.append(circle);

      const revealNode = () => showNodeInfo(node);
      group.addEventListener('pointerenter', revealNode);
      group.addEventListener('pointermove', revealNode);
      group.addEventListener('mouseenter', revealNode);
      group.addEventListener('focus', revealNode);
      group.addEventListener('click', () => {
        selectedNodeId = node.nodeId;
        window.location.href = node.href;
      });
      group.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') window.location.href = node.href;
      });
      nodeLayer.append(group);
      graphElements.nodes.push({ element: group, node });

      if (node.nodeType === 'facet' && (node.count >= 2 || model.facets.length < 28)) {
        const label = createLabelElement(node.name, 'graph-label');
        label.group.setAttribute('data-priority', String(labelPriority(node)));
        labelLayer.append(label.group);
        graphElements.labels.push({ ...label, node, radius, priority: labelPriority(node) });
      }
    }

    viewportLayer.append(linkLayer, nodeLayer, labelLayer);
    fragment.append(viewportLayer, activeLabelLayer);
    svg.append(fragment);
    measureGraphLabels();
    applyViewport();

    const selected = nodesById.get(selectedNodeId);
    if (selected) showNodeInfo(selected);
  }

  function createLabelElement(value, className) {
    const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    group.setAttribute('class', className);

    const background = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    background.setAttribute('class', 'graph-label-bg');
    background.setAttribute('x', '0');
    background.setAttribute('y', '-15');
    background.setAttribute('rx', '5');
    background.setAttribute('height', '22');

    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.textContent = value;
    label.setAttribute('class', 'graph-label-text');
    label.setAttribute('x', '8');
    label.setAttribute('y', '0');

    const width = estimateLabelWidth(value);
    background.setAttribute('width', String(width));
    group.append(background, label);

    return { group, background, label, lines: [{ element: label, value }], width, height: 22 };
  }

  function createActiveLabelElement(node) {
    const title = node.nodeType === 'facet' ? node.name : node.title;
    const subtitle = node.nodeType === 'facet' ? `${node.label} · ${node.count}개 문서` : [node.weekLabel, node.author].filter(Boolean).join(' · ');
    const compactTitle = truncateLabel(title, node.nodeType === 'facet' ? 28 : 34);
    const compactSubtitle = truncateLabel(subtitle, 32);
    const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    group.setAttribute('class', 'graph-hover-label');

    const width = Math.max(estimateLabelWidth(compactTitle), compactSubtitle ? estimateLabelWidth(compactSubtitle) : 0);
    const height = compactSubtitle ? 38 : 26;
    const background = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    background.setAttribute('class', 'graph-label-bg');
    background.setAttribute('x', '0');
    background.setAttribute('y', String(compactSubtitle ? -18 : -16));
    background.setAttribute('rx', '6');
    background.setAttribute('width', String(width));
    background.setAttribute('height', String(height));

    const titleText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    titleText.textContent = compactTitle;
    titleText.setAttribute('class', 'graph-label-text primary');
    titleText.setAttribute('x', '8');
    titleText.setAttribute('y', '0');

    group.append(background, titleText);

    if (compactSubtitle) {
      const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      label.textContent = compactSubtitle;
      label.setAttribute('class', 'graph-label-text secondary');
      label.setAttribute('x', '8');
      label.setAttribute('y', '16');
      group.append(label);
    }

    const lines = [
      { element: titleText, value: compactTitle },
      ...(compactSubtitle ? [{ element: group.querySelector('.secondary'), value: compactSubtitle }] : []),
    ];

    return { group, background, lines, width, height };
  }

  function setZoom(value) {
    viewport.scale = clamp(value, Number(zoomLevel.min), Number(zoomLevel.max));
    applyViewport();
  }

  function resetViewport() {
    viewport.scale = 1;
    viewport.x = 0;
    viewport.y = 0;
    applyViewport();
  }

  function applyViewport() {
    zoomLevel.value = viewport.scale.toFixed(1);
    zoomValue.textContent = `${Math.round(viewport.scale * 100)}%`;
    zoomValue.setAttribute('aria-label', `확대 ${Math.round(viewport.scale * 100)}%, 간격 ${Math.round(spreadFactor() * 100)}%`);
    applySpread();
    if (!viewportLayer) return;

    const cx = graphSize.width / 2;
    const cy = graphSize.height / 2;
    viewportLayer.setAttribute(
      'transform',
      `translate(${cx + viewport.x} ${cy + viewport.y}) scale(${viewport.scale}) translate(${-cx} ${-cy})`,
    );
  }

  function endPan(event) {
    if (!panStart.active || panStart.pointerId !== event.pointerId) return;
    panStart.active = false;
    svg.classList.remove('panning');
    if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);
  }

  function applySpread() {
    if (!viewportLayer) return;

    for (const link of graphElements.links) {
      const source = spreadPoint(link.source.x, link.source.y);
      const target = spreadPoint(link.target.x, link.target.y);
      link.element.setAttribute('x1', source.x);
      link.element.setAttribute('y1', source.y);
      link.element.setAttribute('x2', target.x);
      link.element.setAttribute('y2', target.y);
    }

    for (const item of graphElements.nodes) {
      const point = spreadPoint(item.node.x, item.node.y);
      item.element.setAttribute('transform', `translate(${point.x}, ${point.y})`);
    }

    for (const item of graphElements.labels) {
      const position = labelPosition(item);
      item.group.setAttribute('transform', `translate(${position.x}, ${position.y})`);
    }
    placeLabels();
    if (activeLabelNode) showActiveLabel(activeLabelNode, { force: true });
  }

  function measureGraphLabels() {
    const maxWidth = Math.min(260, Math.max(86, graphSize.width * 0.32));
    for (const item of graphElements.labels) {
      measureLabelElement(item, maxWidth);
    }
  }

  function spreadPoint(x, y) {
    const cx = graphSize.width / 2;
    const cy = graphSize.height / 2;
    const factor = spreadFactor();
    return {
      x: cx + (x - cx) * factor,
      y: cy + (y - cy) * factor,
    };
  }

  function spreadFactor() {
    return 1 + Math.max(0, viewport.scale - 1) * 1.15;
  }

  function labelPosition(item) {
    const point = spreadPoint(item.node.x, item.node.y);
    const padding = 10;
    const rightX = point.x + item.radius + 6;
    const leftX = point.x - item.radius - item.width - 6;
    const x =
      rightX + item.width <= graphSize.width - padding || leftX < padding
        ? clamp(rightX, padding, Math.max(padding, graphSize.width - item.width - padding))
        : leftX;
    return {
      x,
      y: clamp(point.y + 4, 20, graphSize.height - 12),
    };
  }

  function placeLabels() {
    const maxVisibleLabels = graphSize.width < 640 ? 18 : graphSize.width < 920 ? 30 : 42;
    const accepted = [];
    const labels = [...graphElements.labels].sort(
      (a, b) => b.priority - a.priority || b.node.count - a.node.count || a.node.name.localeCompare(b.node.name, 'ko'),
    );

    for (const item of labels) {
      const position = labelPosition(item);
      const box = {
        x: position.x,
        y: position.y - 15,
        width: item.width,
        height: item.height,
      };
      const visible =
        accepted.length < maxVisibleLabels &&
        box.x < graphSize.width - 8 &&
        box.y > 8 &&
        box.x + box.width > 8 &&
        box.y + box.height < graphSize.height - 8 &&
        accepted.every((candidate) => !boxesOverlap(box, candidate, 5));

      item.group.style.display = visible ? '' : 'none';
      if (visible) accepted.push(box);
    }
  }

  function showActiveLabel(node, options = {}) {
    if (!activeLabelLayer) return;
    if (!options.force && activeLabelNode === node && activeLabelLayer.childElementCount > 0) return;
    activeLabelNode = node;
    activeLabelLayer.replaceChildren();

    const label = createActiveLabelElement(node);
    activeLabelLayer.append(label.group);
    measureLabelElement(label, Math.min(520, Math.max(180, graphSize.width - 24)));

    const point = viewportPoint(node.x, node.y);
    const radius = node.radius ?? 8;
    let x = point.x + radius + 10;
    if (x + label.width > graphSize.width - 10) x = point.x - radius - label.width - 10;
    x = clamp(x, 10, Math.max(10, graphSize.width - label.width - 10));
    const topOffset = label.height > 30 ? 18 : 16;
    let y = point.y;
    y = clamp(y, topOffset + 10, graphSize.height - 14);

    label.group.setAttribute('transform', `translate(${x}, ${y})`);
  }

  function viewportPoint(x, y) {
    const point = spreadPoint(x, y);
    const cx = graphSize.width / 2;
    const cy = graphSize.height / 2;
    return {
      x: cx + viewport.x + (point.x - cx) * viewport.scale,
      y: cy + viewport.y + (point.y - cy) * viewport.scale,
    };
  }

  function measureLabelElement(label, maxWidth) {
    const horizontalPadding = 16;
    const safeMaxWidth = clamp(maxWidth, 48, Math.max(48, graphSize.width - 20));
    const maxTextWidth = Math.max(24, safeMaxWidth - horizontalPadding);
    const textWidths = label.lines.map((line) => {
      fitSvgText(line.element, line.value, maxTextWidth);
      return svgTextLength(line.element, line.value);
    });
    const width = clamp(Math.ceil(Math.max(...textWidths, 0) + horizontalPadding), 48, safeMaxWidth);
    label.width = width;
    label.background.setAttribute('width', String(width));
    return label;
  }

  function fitSvgText(element, value, maxWidth) {
    const text = String(value ?? '');
    element.textContent = text;
    if (svgTextLength(element, text) <= maxWidth) return text;

    const characters = Array.from(text);
    let low = 1;
    let high = characters.length - 1;
    let best = '…';

    while (low <= high) {
      const middle = Math.floor((low + high) / 2);
      const candidate = `${characters.slice(0, middle).join('')}…`;
      element.textContent = candidate;
      if (svgTextLength(element, candidate) <= maxWidth) {
        best = candidate;
        low = middle + 1;
      } else {
        high = middle - 1;
      }
    }

    element.textContent = best;
    return best;
  }

  function svgTextLength(element, fallbackValue) {
    try {
      const measured = element.getComputedTextLength();
      if (Number.isFinite(measured) && measured > 0) return measured;
    } catch {
      // Fall through to the width heuristic below.
    }
    return Math.max(0, estimateTextWidth(fallbackValue ?? element.textContent ?? ''));
  }

  function boxesOverlap(a, b, padding) {
    return !(
      a.x + a.width + padding < b.x ||
      b.x + b.width + padding < a.x ||
      a.y + a.height + padding < b.y ||
      b.y + b.height + padding < a.y
    );
  }

  function estimateLabelWidth(value) {
    const width = estimateTextWidth(value) + 18;
    return Math.max(48, Math.round(width));
  }

  function estimateTextWidth(value) {
    return Array.from(String(value)).reduce((sum, character) => {
      if (/[a-z0-9]/iu.test(character)) return sum + 7;
      if (/[.,:;()[\]{}·/\-]/u.test(character)) return sum + 4;
      return sum + 10.5;
    }, 0);
  }

  function labelPriority(node) {
    return (node.count ?? 0) * (node.weight ?? 1);
  }

  function truncateLabel(value, maxLength) {
    const characters = Array.from(String(value ?? ''));
    if (characters.length <= maxLength) return characters.join('');
    return `${characters.slice(0, Math.max(0, maxLength - 1)).join('')}…`;
  }

  function layoutNodes(nodes, links, width, height) {
    const cx = width / 2;
    const cy = height / 2;
    const facetNodes = nodes.filter((node) => node.nodeType === 'facet');
    const docNodes = nodes.filter((node) => node.nodeType === 'doc');
    const marginX = clamp(width * 0.04, 30, 52);
    const marginY = clamp(height * 0.05, 26, 44);
    const outerRadiusX = Math.max(120, (width - marginX * 2) * 0.42);
    const outerRadiusY = Math.max(120, (height - marginY * 2) * 0.38);
    const innerRadiusX = outerRadiusX * 0.42;
    const innerRadiusY = outerRadiusY * 0.44;

    facetNodes.forEach((node, index) => {
      const angle = (index / Math.max(facetNodes.length, 1)) * Math.PI * 2 - Math.PI / 2;
      node.x = cx + Math.cos(angle) * outerRadiusX;
      node.y = cy + Math.sin(angle) * outerRadiusY;
      node.vx = 0;
      node.vy = 0;
    });
    docNodes.forEach((node, index) => {
      const angle = (index / Math.max(docNodes.length, 1)) * Math.PI * 2 + Math.PI / 5;
      node.x = cx + Math.cos(angle) * innerRadiusX;
      node.y = cy + Math.sin(angle) * innerRadiusY;
      node.vx = 0;
      node.vy = 0;
    });

    const nodesById = new Map(nodes.map((node) => [node.nodeId, node]));
    const pairs = links
      .map((link) => ({ source: nodesById.get(link.source), target: nodesById.get(link.target) }))
      .filter((link) => link.source && link.target);

    for (let step = 0; step < 150; step += 1) {
      for (const pair of pairs) {
        const dx = pair.target.x - pair.source.x;
        const dy = pair.target.y - pair.source.y;
        const distance = Math.hypot(dx, dy) || 1;
        const ideal = pair.source.nodeType === 'doc' ? 92 : 110;
        const force = (distance - ideal) * 0.006;
        const fx = (dx / distance) * force;
        const fy = (dy / distance) * force;
        pair.source.vx += fx;
        pair.source.vy += fy;
        pair.target.vx -= fx;
        pair.target.vy -= fy;
      }

      for (let a = 0; a < nodes.length; a += 1) {
        for (let b = a + 1; b < nodes.length; b += 1) {
          const left = nodes[a];
          const right = nodes[b];
          const dx = right.x - left.x;
          const dy = right.y - left.y;
          const distance = Math.hypot(dx, dy) || 1;
          if (distance > 115) continue;
          const force = (115 - distance) * 0.0018;
          const fx = (dx / distance) * force;
          const fy = (dy / distance) * force;
          left.vx -= fx;
          left.vy -= fy;
          right.vx += fx;
          right.vy += fy;
        }
      }

      for (const node of nodes) {
        const dx = cx - node.x;
        const dy = cy - node.y;
        node.vx += dx * 0.0008;
        node.vy += dy * 0.0008;
        if (node.nodeType === 'facet') {
          const angle = Math.atan2(node.y - cy, node.x - cx);
          node.vx += (cx + Math.cos(angle) * outerRadiusX - node.x) * 0.004;
          node.vy += (cy + Math.sin(angle) * outerRadiusY - node.y) * 0.004;
        }
        node.x = clamp(node.x + node.vx, marginX, width - marginX);
        node.y = clamp(node.y + node.vy, marginY, height - marginY);
        node.vx *= 0.72;
        node.vy *= 0.72;
      }
    }

    return nodes;
  }

  function showNodeInfo(node) {
    selectedNodeId = node.nodeId;
    showActiveLabel(node);
    if (node.nodeType === 'doc') {
      info.innerHTML = `
        <strong>${escapeHtml(node.title)}</strong>
        <p>${escapeHtml([node.weekLabel, node.author, node.date].filter(Boolean).join(' · '))}</p>
        <a class="button-link primary" href="${node.href}">문서 열기</a>
      `;
      return;
    }

    info.innerHTML = `
      <strong>${escapeHtml(node.name)}</strong>
      <p>${escapeHtml(node.label)} · ${node.count}개 문서</p>
      <a class="button-link primary" href="${node.href}">색인 열기</a>
    `;
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (character) => {
      const replacements = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
      return replacements[character];
    });
  }

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }
</script>

